/* useSocket.js is for implimentation of all socket.io feature such as 
    1. video consultation 
    2. video consultation room
    3. doctor availability 
  These function will work with the front-end for real-time communication */ 


const userSocketIdMap = new Map(); //a map of online usernames and their clients

function useSocket(io) {
  let users = {};
  
  // Log socket connection events
  io.on('connection', (socket) => {
    console.log(`Socket connected: ${socket.id}`);
    
    socket.on('disconnect', () => {
      console.log(`Socket disconnected: ${socket.id}`);
    });
    
    socket.on('error', (error) => {
      console.error(`Socket error for ${socket.id}:`, error);
    });

    // ** video chat app **
    // join consultation room
    socket.on('join-room', (roomId, userId) => {
      console.log(`User ${userId} joining room ${roomId} with socket ${socket.id}`);
      
      // Leave any previous rooms to avoid conflicts
      socket.rooms.forEach(room => {
        if (room !== socket.id && room !== roomId) {
          console.log(`Leaving previous room: ${room}`);
          socket.leave(room);
        }
      });
      
      // Track room participants with a Map
      if (!io.videoRooms) {
        io.videoRooms = new Map();
      }
      
      // Add user to room tracking
      if (!io.videoRooms.has(roomId)) {
        io.videoRooms.set(roomId, new Set());
      }
      io.videoRooms.get(roomId).add(userId);
      
      // Join the new room
      socket.join(roomId);
      
      // Store user data for easier reference
      socket.userId = userId;
      socket.currentRoom = roomId;
      
      // Broadcast to all users in the room that a new user has connected
      socket.to(roomId).emit('user-connected', userId);
      
      // Log room participants for debugging
      const clients = io.sockets.adapter.rooms.get(roomId);
      const numClients = clients ? clients.size : 0;
      console.log(`Room ${roomId} now has ${numClients} participants`);
      
      // Log all clients in the room
      if (clients) {
        console.log('Clients in room:', Array.from(clients));
      }

      // Handle peer ID updates (for reconnection support)
      socket.on('peer-id', (peerId, roomId) => {
        console.log(`User ${userId} updated peer ID to ${peerId} in room ${roomId}`);
        // Store the peer ID with the socket for reference
        socket.peerId = peerId;
        // Notify others about this peer (optional - for advanced reconnection)
        socket.to(roomId).emit('peer-updated', userId, peerId);
      });

      // sent message to other to join
      socket.on('message', (message) => {
        console.log(`Message in room ${roomId}: ${message}`);
        socket.to(roomId).emit('createMessage', message, userId);
      });

      // Handle explicit room leaving
      socket.on('leave-room', (roomId, userId) => {
        console.log(`User ${userId} explicitly left room ${roomId}`);
        handleUserLeaving(socket, roomId, userId);
      });

      // disconnect from the room
      socket.on('disconnect', () => {
        console.log(`Socket ${socket.id} disconnected, user ${userId} left room ${roomId}`);
        handleUserLeaving(socket, roomId, userId);
      });
    });
    
    // Helper function to handle user leaving a room
    function handleUserLeaving(socket, roomId, userId) {
      // Remove from room tracking
      if (io.videoRooms && io.videoRooms.has(roomId)) {
        io.videoRooms.get(roomId).delete(userId);
        // Clean up empty rooms
        if (io.videoRooms.get(roomId).size === 0) {
          io.videoRooms.delete(roomId);
          console.log(`Room ${roomId} is now empty and removed from tracking`);
        }
      }
      
      // Leave the socket room
      socket.leave(roomId);
      
      // Notify others in the room
      socket.to(roomId).emit('user-disconnected', userId);
      
      // Log room participants after disconnect
      const remainingClients = io.sockets.adapter.rooms.get(roomId);
      const remainingCount = remainingClients ? remainingClients.size : 0;
      console.log(`Room ${roomId} now has ${remainingCount} participants after disconnect`);
    }

    // ** doctor availability **
    socket.on('online-user', (socketId, userId) => {
      // doctor join the available doctor room
      console.log(`Doctor ${userId} is now online with socket ${socketId}`);
      users = addClientToMap(userId, socketId);
      
      // Immediately broadcast updated doctor list to all connected clients
      console.log("Broadcasting updated doctor list");
      socket.broadcast.emit('updateDoctorList', users);

      // doctor exit the online doctor room
      socket.on('disconnect', () => {
        console.log(`Doctor ${userId} went offline`);
        users = removeClientFromMap(userId, socketId);
        console.log("Broadcasting updated doctor list after disconnect");
        io.emit('updateDoctorList', users);
      });
    });

    // client get the online doctor list
    socket.on('get-online-doctor', (fillter) => {
      console.log(`Client requesting online doctors for filter: ${fillter}`);
      console.log("Current online doctors:", users);
      socket.join(fillter);
      io.to(fillter).emit('updateDoctorList', users);
    });

    // ** video consultation **
    // patient make a call
    socket.on('call', (socketId, message) => {
      console.log(`Call request from ${message.from} to ${socketId} for room ${message.url}`);
      let rooms = mapToObject(io.sockets.adapter.rooms); // set request to doctor
      if (!rooms[message.url]) {
        console.log(`Room ${message.url} is Available for call`);
        io.to(socketId).emit('retrieve', message);
        io.to(message.from).emit('availableCall', true);
      } else {
        console.log(`Room ${message.url} is Not Available for call`);
        io.to(message.from).emit('availableCall', false);
      }
    });

    // doctor answer call 
    socket.on('answerCall', (fromId, status) => {
      console.log(`Doctor answered call from ${fromId} with status: ${status}`);
      io.to(fromId).emit('retrieveCall', status);
    });
  });
}

// This function is use for adding the doctor to the available doctor room 
// Doctor that are in that room are doctor who online and can have consult with patient.
function addClientToMap(userId, socketId) {
  if (!userSocketIdMap.has(userId)) {
    //when user is joining first time
    userSocketIdMap.set(userId, new Set([socketId]));
  } else {
    //user had already joined from one client and now joining using another client
    userSocketIdMap.get(userId).add(socketId);
  }
  return mapToObject(userSocketIdMap);
}

// This function is use for removing the doctor to the available doctor room when the doctor is offline
function removeClientFromMap(userId, socketId) {
  if (userSocketIdMap.has(userId)) {
    let userSocketIdSet = userSocketIdMap.get(userId);
    userSocketIdSet.delete(socketId);
    //if there are no clients for a user, remove that user from online
    if (userSocketIdSet.size == 0) {
      userSocketIdMap.delete(userId);
    }
  }
  return mapToObject(userSocketIdMap);
}

// This is a reusable function for change the javascript map to object type
function mapToObject(userSocketIdMap) {
  const obj = Object.fromEntries(userSocketIdMap);

  Object.keys(obj).forEach((key) => {
    obj[key] = Array.from(obj[key]);
  });
  return obj;
}
module.exports = useSocket;

